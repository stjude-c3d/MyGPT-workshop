# Copy to .env and edit. .env is ignored by Git — never commit real credentials.

# Docker: compose.yaml overrides MYGPT_BASE_URL and OLLAMA_URL with host.docker.internal,
# so these localhost values are only used by the local-Python alternative.
# Use DOCKER_MYGPT_BASE_URL / DOCKER_OLLAMA_URL to point the container somewhere else.
# Optional: WORKSHOP_IMAGE_TAG (default latest), WORKSHOP_PORT (8888), JUPYTER_TOKEN.

# MyGPT backend (Django). Default local Docker install listens on port 8000.
MYGPT_BASE_URL=http://localhost:8000
# Superuser created with create_superuser.sh (SETUP.md step 3)
MYGPT_USERNAME=
MYGPT_PASSWORD=
# Email used as the library owner in the MyGPT UI (leave empty to list all you can see)
MYGPT_USER_EMAIL=

# Library you build in module 1
MYGPT_DATASET=workshop-library-A

# Models (SETUP.md "Choose where the models run")
# Options A and B (Ollama):
MYGPT_LLM=llama3:latest
MYGPT_EMBEDDING_MODEL=nomic-embed-text:latest
# Option C (OpenAI API, set in MyGPT's .env_backend; never put the key here):
# MYGPT_LLM=gpt-6-luna
# MYGPT_EMBEDDING_MODEL=text-embedding-3-small
# JUDGE_LLM=gpt-6-luna

# Ollama endpoint (used directly for question generation and the LLM judge)
OLLAMA_URL=http://localhost:11434
# Option B (St. Jude Ollama server): set both to the server URL from the instructors
# OLLAMA_URL=<St. Jude Ollama server URL>
# DOCKER_OLLAMA_URL=<St. Jude Ollama server URL>
# Model used as LLM judge in module 3 (can differ from MYGPT_LLM)
JUDGE_LLM=llama3:latest
